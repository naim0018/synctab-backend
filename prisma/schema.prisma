// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  password  String?
  avatar    String   // URL or identifier for display avatar
  status    String   @default("Active") // Active, In Meeting, Away, etc.
  accentColor    String   @default("#8b5cf6")
  blurIntensity  String   @default("20px")
  clockFormat24h Boolean  @default(false)
  createdAt DateTime @default(now())
  
  // Relations
  tasksAssigned Task[]     @relation("TaskAssignee")
  tasksCreated  Task[]     @relation("TaskCreator")
  notes         Note[]
  bookmarks     Bookmark[]
  reminders     Reminder[]
  messages      Message[]
  customWallpapers    CustomWallpaper[]
  linkedGoogleAccounts LinkedGoogleAccount[]
  widgets              Widget[]
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  isShared  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate     DateTime?
  
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  creatorId   String
  creator     User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Bookmark {
  id        String   @id @default(uuid())
  title     String
  url       String
  category  String   @default("General")
  position  Int      @default(0)
  clicks    Int      @default(0)
  isShared  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Reminder {
  id          String   @id @default(uuid())
  text        String
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CustomWallpaper {
  id        String   @id @default(uuid())
  name      String
  url       String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model LinkedGoogleAccount {
  id          String   @id @default(uuid())
  googleEmail String   @unique
  displayName String?
  avatarUrl   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Widget {
  id        String   @id
  type      String
  x         Int
  y         Int
  w         Int
  h         Int
  pageId    String   @default("dashboard")
  config    String   @default("{}")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== ISSUE TRACKING ====================

model IssueProject {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  icon        String   @default("🗂️")
  color       String   @default("#6366f1")
  ownerId     String
  inviteToken String   @unique @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issues      Issue[]
  members     IssueProjectMember[]
}

model IssueProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  project   IssueProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Issue {
  id          String    @id @default(uuid())
  title       String
  description String    @default("")
  status      String    @default("open")
  priority    String    @default("medium")
  label       String    @default("")
  position    Int       @default(0)
  projectId   String
  creatorId   String
  assigneeId  String?
  dueDate     DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     IssueProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    IssueComment[]
}

model IssueComment {
  id        String   @id @default(uuid())
  text      String
  issueId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue     Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}
